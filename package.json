{
  "name": "kiss",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint && prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e",
    "assets:fetch-dev": "./tools/fetch-dev-samples.sh",
    "assets:synth": "tsx tools/synth-variants.ts --src assets/source/base-a/neutral.vrm --out assets/source/base-a/morphs",
    "assets:base": "tsx tools/build-base.ts --src assets/source/base-a --out public/assets/avatars/base-a.vrm --webp",
    "assets": "npm run assets:base && npm run assets:hair && npm run assets:catalog",
    "assets:dev": "npm run assets:fetch-dev && npm run assets:synth && npm run assets",
    "assets:hair": "tsx tools/build-hair.ts --src assets/source/hair --out public/assets/hair --webp",
    "assets:catalog": "tsx tools/build-catalog.ts --source assets/source --public public/assets --out public/assets/catalog.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.2",
    "@pixiv/three-vrm": "^3.5.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
